{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "isSinglePageApplication": true,
      "url": ["http://localhost/index.html", "http://localhost/login"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["uses-http2", "canonical", "is-on-https", "redirects-http"]
      }
    },
    "assert": {
      "_comment": "No assertion preset is used: presets inject checks outside the explicitly collected categories and can cause spurious auditRan failures. Keep assertions explicit below.",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],

        "first-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "speed-index": ["error", { "maxNumericValue": 3400 }],
        "interactive": ["error", { "maxNumericValue": 3500 }],
        "mainthread-work-breakdown": ["error", { "maxNumericValue": 2500 }],
        "bootup-time": ["error", { "maxNumericValue": 1500 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 700000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1600000 }],

        "unused-javascript": "off",
        "legacy-javascript": "off",
        "unused-css-rules": "off",
        "uses-long-cache-ttl": "off",
        "uses-text-compression": "off",
        "csp-xss": "off",
        "errors-in-console": "off",
        "valid-source-maps": "off",
        "render-blocking-resources": "warn",
        "meta-description": "warn",
        "font-display": "warn",
        "third-party-facades": "off",
        "modern-image-formats": "warn",
        "uses-responsive-images": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
