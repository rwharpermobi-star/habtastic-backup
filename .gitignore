# Android generated output (regenerated by `cap sync` / Gradle in CI)
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.aar

# Signing material — must NEVER be committed (CI injects from secrets)
*.keystore
*.jks
android/app/release.keystore
android/key.properties

# Environment/config credentials are injected by Lovable/GitHub/Supabase.
# Do not commit them, even when a specific value is technically publishable.
.env
.env.local
.env.*.local
android/app/google-services.json

# Lighthouse CI build artifacts
.lighthouseci/
