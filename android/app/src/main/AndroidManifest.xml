<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Winston voice input: Capacitor's WebView requests these at runtime when getUserMedia({ audio: true }) is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ runtime notification permission (requested by @capacitor/push-notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Habit reminders at the exact time the user picks. User-granted special access
         (Settings > Alarms & reminders); the app falls back to inexact alarms when it is off.
         Deliberately NOT USE_EXACT_ALARM, which Play restricts to alarm-clock/calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Google Play Billing (declared explicitly so it never relies on plugin manifest merging) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Advertising ID (required by AdMob on Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Android 11+ package visibility: lets the native mic plugin
         (@capacitor-community/speech-recognition) find the speech recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Return path for native Google OAuth (see src/lib/nativeGoogleAuth.ts).
                 Must stay in sync with NATIVE_GOOGLE_REDIRECT_URI = lovable://oauth-callback -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lovable" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Google AdMob application ID (live HabTastic AI app).
             Test vs production creatives are controlled by VITE_ADMOB_LIVE in
             the web layer (src/lib/ads/adConfig.ts): debug/preview builds keep
             using Google's test ad units and isTesting mode. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1971238777773206~4099124115"
        />
        <!-- Delay ad SDK init until after first paint so ads can never slow startup -->
        <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" />
        <!-- Firebase Cloud Messaging defaults.
             channel id MUST match ANDROID_CHANNEL_ID in src/hooks/useNativePush.ts
             and android.notification.channel_id in
             supabase/functions/_shared/nativePush.ts, otherwise Android 8+
             silently drops notifications delivered while the app is closed.
             The small icon must be a monochrome alpha mask — Android renders a
             colored launcher mipmap as a solid white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="habtastic_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_habtastic" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/habtastic_notification" />
    </application>
</manifest>
